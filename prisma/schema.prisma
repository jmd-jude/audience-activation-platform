generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Segment {
  id            String   @id @default(cuid())
  segmentName   String
  description   String
  targetUseCase String
  sqlQuery      String
  status        String   @default("draft") // "draft", "approved", "active"
  createdBy     String   @default("demo-user")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  usageCount    Int      @default(0)
  lastUsed      DateTime?
  estimatedSize Int?
  approvedBy    String?
  approvedAt    DateTime?
}
